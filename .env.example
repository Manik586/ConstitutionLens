# Application environment. Copy to .env (never commit .env). No secrets in configs/v1.yaml.

LOG_LEVEL=INFO

# Local paths (relative paths resolve against CER_DATA_ROOT when it is set, otherwise
# against the current directory). Docker sets CER_DATA_ROOT=/app.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
INDEXES_DIR=indexes
# CER_DATA_ROOT=
# UPLOADS_DIR=data/uploads
# MODELS_DIR=models
# CER_CONFIG=configs/v1.yaml

# Phase 7 user corpora (see configs/v1.yaml `corpus` and `uploads`)
# DEFAULT_CORPUS_ID=constitutional-core
# UPLOAD_MAX_FILE_SIZE_MB=20
# UPLOAD_MAX_DOCUMENTS=20
# UPLOAD_MAX_TOTAL_SIZE_MB=200
# UPLOAD_MAX_PAGES=500

# docker-compose host port for the API
# HOST_PORT=8000

# Frontend hosted on another origin (e.g. Vercel), comma-separated exact origins:
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
# Optional shared access token (16+ characters). When set, the UI asks for it once and every
# API call must send it. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
# API_ACCESS_TOKEN=

# Phase 5 LLM (optional; see configs/v1.yaml `llm`). Never commit a real key.
# With generation on, retrieved evidence — including text from uploaded documents —
# is sent to this provider.
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY=
# Consent to send corpus passages to a non-localhost provider (keeps configs/v1.yaml at false):
# LLM_ALLOW_REMOTE=true
# Local servers without keys (e.g. Ollama):
# LLM_REQUIRE_API_KEY=false
